        "attempt_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "location": {"$ref": "#/$defs/artifactLocation"},
        "sha256": {"$ref": "#/$defs/nullableSha256"},
        "bytes": {"type": ["integer", "null"], "minimum": 0},
        "media_type": {"type": ["string", "null"]},
        "native_format": {"type": ["string", "null"]},
        "latest_material_state": {"$ref": "#/$defs/nullableElapsedValue"},
        "acquired_at": {"$ref": "#/$defs/nullableTimestamp"},
        "created_at": {"$ref": "#/$defs/nullableTimestamp"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "retention_class": {"type": "string", "enum": ["exact_native", "deterministic_derivative", "lossy_derivative", "reconstructable", "deleted_inaccessible", "never_captured"]},
        "immutability_status": {"type": "string", "enum": ["frozen", "mutable_source_snapshot", "tombstone"]},
        "source_artifact_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "reason_codes": {"$ref": "#/$defs/reasonCodes"},
        "nonconfirmatory": {"type": "boolean"},
        "domain_payload": {"$ref": "#/$defs/domainPayload"}
      },
      "allOf": [
        {
          "if": {"properties": {"location": {"properties": {"status": {"enum": ["available_bundle_file", "available_external"]}}, "required": ["status"]}}},
          "then": {
            "properties": {
              "sha256": {"$ref": "#/$defs/sha256"},
              "bytes": {"type": "integer", "minimum": 0},
              "media_type": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"location": {"properties": {"status": {"enum": ["inaccessible", "deleted", "never_captured"]}}, "required": ["status"]}}},
